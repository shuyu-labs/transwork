# TransWork 演示环境默认配置
# 本文件与 docker-compose.yaml 放在同一目录，直接执行 docker compose up -d 即可。

PATH2AI_HTTP_PORT=3000
FILEEXT_HTTP_PORT=5002
PATH2AI_PUBLIC_BASE_URL=http://localhost:3000

# WebAgent 浏览器访问端口；后台地址使用 Compose 服务名，不要填 localhost。
WEBAGENT_HTTP_PORT=4100
PATH2AI_WEB_BASE_URL=http://transwork-web:3000
# HTTP 演示用 development；配置 WebAgent 的 HTTPS 反向代理后改为 production。
WEBAGENT_NODE_ENV=development

# ── 命令执行（Bash）──────────────────────────────────────────────
# off    = 只演示问答；docx/xlsx 这类要跑脚本的技能不可用（默认，最安全）
# docker = 可以生成 Word/Excel；需要宿主机 Docker + 预先拉取沙箱镜像
#          并且叠加 docker-compose.sandbox.yaml 启动（见 docs 部署手册第 7 节）
WEBAGENT_SANDBOX=off
WEBAGENT_SANDBOX_IMAGE=registry.cn-hangzhou.aliyuncs.com/tree456/transwork-webagent-sandbox:1.0.0
# docker 模式必填：transwork-webagent-data 卷在宿主机上的真实路径
# 查法：docker volume inspect <目录名>_transwork-webagent-data -f '{{.Mountpoint}}'
WEBAGENT_SANDBOX_HOST_DATA_DIR=
# 沙箱是否允许联网（默认不允许；装了依赖才能联网）
WEBAGENT_SANDBOX_NETWORK=false
# 宿主机 docker CLI 路径，叠加 docker-compose.sandbox.yaml 时用；不确定就跑 which docker
DOCKER_CLI_PATH=/usr/bin/docker
# 宿主 docker 组的 gid：getent group docker | cut -d: -f3
DOCKER_GID=988

# 后台管理员账号
PATH2AI_ADMIN_USERNAME=admin
PATH2AI_ADMIN_PASSWORD=TransWork_Admin_2026
PATH2AI_ADMIN_SESSION_HOURS=24

# PostgreSQL 账号
POSTGRES_DB=transwork
POSTGRES_USER=transwork
POSTGRES_PASSWORD=TransWork_DB_2026_Demo
PATH2AI_POSTGRES_CONNECTION_STRING=postgresql://transwork:TransWork_DB_2026_Demo@postgres:5432/transwork
PATH2AI_POSTGRES_ADMIN_CONNECTION_STRING=postgresql://transwork:TransWork_DB_2026_Demo@postgres:5432/transwork
PATH2AI_POSTGRES_INIT_TIMEOUT_MS=30000

# 模型网关主密钥，至少 32 个字符
PATH2AI_MODEL_GATEWAY_MASTER_KEY=transwork-demo-model-gateway-master-key-2026

# 文档解析服务
FILE_EXTRACTION_BASE_URL=http://fileext:5000
FILE_EXTRACTION_SERVICE_TOKEN=
FILE_EXTRACTION_TIMEOUT_MS=120000
FILEEXT_IMAGE_BASE_URL=http://localhost:5002
